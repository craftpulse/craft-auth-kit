{
    "name": "craftpulse/craft-auth-kit",
    "description": "Foundational authentication primitives for Craft CMS: passwordless tokens (magic links + email OTP), passkey wrappers, a recent-auth gate, and a password-validator contract. A library-shipped Yii module, the shared base for the CraftPulse security ecosystem.",
    "type": "library",
    "version": "1.9.0",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-module",
        "authentication",
        "passwordless",
        "magic-link",
        "otp",
        "passkeys",
        "webauthn"
    ],
    "support": {
        "email": "support@craft-pulse.com",
        "issues": "https://github.com/craftpulse/craft-auth-kit/issues",
        "source": "https://github.com/craftpulse/craft-auth-kit",
        "docs": "https://github.com/craftpulse/craft-auth-kit/blob/v5/docs/README.md"
    },
    "authors": [
        {
            "name": "CraftPulse",
            "homepage": "https://craft-pulse.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.10.0",
        "maxmind-db/reader": "^1.11"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "markhuot/craft-pest-core": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "craftpulse\\authkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "craftpulse\\authkit\\tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop-v5": "1.x-dev",
            "dev-v5": "1.x-dev"
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
