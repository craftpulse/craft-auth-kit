{
    "name": "craftpulse/craft-auth-kit",
    "description": "Foundational authentication primitives for Craft CMS — passwordless tokens (magic links + email OTP), passkey wrappers, a recent-auth gate, and a password-validator contract. The shared base for the CraftPulse security ecosystem.",
    "type": "craft-plugin",
    "version": "1.4.0",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "authentication",
        "passwordless",
        "magic-link",
        "otp",
        "passkeys",
        "webauthn"
    ],
    "support": {
        "email": "support@craft-pulse.com",
        "issues": "https://github.com/craftpulse/craft-auth-kit/issues",
        "source": "https://github.com/craftpulse/craft-auth-kit",
        "docs": "https://github.com/craftpulse/craft-auth-kit/blob/main/README.md"
    },
    "authors": [
        {
            "name": "CraftPulse",
            "homepage": "https://craft-pulse.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.10.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "markhuot/craft-pest-core": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "craftpulse\\authkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "craftpulse\\authkit\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "auth-kit",
        "name": "Auth Kit",
        "class": "craftpulse\\authkit\\AuthKit",
        "documentationUrl": "https://github.com/craftpulse/craft-auth-kit/blob/main/README.md",
        "craftcms-claude-skills": "1.6.2"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
